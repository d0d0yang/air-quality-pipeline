# copy to .env and fill in. .env is gitignored, never commit it.

# --- local development ---
# sa password for the local docker sql server (any strong random string)
LOCAL_SA_PASSWORD=
# odbc connection string. the default below targets the docker container; {LOCAL_SA_PASSWORD} is filled in by config.py
SQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=airqualitydb;Uid=sa;Pwd={LOCAL_SA_PASSWORD};Encrypt=yes;TrustServerCertificate=yes
# local or blob
STORAGE_MODE=local
# landing/, publish/, cache/, manual/ live under here in local mode
LOCAL_DATA_DIR=./data
# only needed when STORAGE_MODE=blob
AZURE_STORAGE_CONNECTION_STRING=

# --- sources ---
# free key from explore.openaq.org
OPENAQ_API_KEY=
# lon_min,lat_min,lon_max,lat_max (default: southern ontario / golden horseshoe)
REGION_BBOX=-81.0,42.8,-78.5,44.6
POLLUTANTS=pm25,o3,no2
HISTORY_YEARS=4
LOOKBACK_HOURS=48
INCLUDE_LOW_COST_SENSORS=1
MAX_MATCH_KM=25
# stay under openaq's 60 requests/minute
OPENAQ_RPM=50
# daily or weekly (the adf trigger is generated from this)
REFRESH_SCHEDULE=daily
# development only: reuse raw downloads of past data from data/cache/ (benchmarks refuse to run with it on)
DEV_CACHE=0
USER_AGENT=air-quality-pipeline (github.com/d0d0yang/air-quality-pipeline)

# --- azure (only needed for infra/deploy.py) ---
AZ_SUBSCRIPTION_ID=
AZ_RESOURCE_GROUP=rg-air-quality-pipeline
AZ_LOCATION=canadacentral
AZ_SQL_ADMIN_USER=aqadmin
AZ_SQL_ADMIN_PASSWORD=
AZ_SQL_ETL_PASSWORD=
